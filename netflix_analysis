#A. User & Basic Analysis
#1.NetFlix wants to maintain a user directory. Display complete details of all registered users.
select * from users; 

#2.Management wants to know the different countries StreamFlix users are coming from. Display the unique user countries.
select distinct * from users;

#3.Identify all users whose current account status is 'Active'. 
select * from users where Status = 'Active';

#4.Find users who are registered in either the 'Premium' or 'Standard' plan (PlanID 2 or 3).
select *from users where PlanID in (2,3);

#5.Identify users who are registered in countries other than the 'United Kingdom'.
select * from users where country <> 'United Kingdom';

#6.Find users who registered between January 1, 2023, and December 31, 2023, for cohort analysis.
select *from users where RegistrationDate between '2023-01-01' and '2023-12-31';

#7.Identify users belonging to 'Canada', 'Australia', 'Germany', or 'France'. 
select * from users where Country in ('Canada', 'Australia', 'Germany', 'France');

#8.Find users whose email addresses begin with the letter 'M' (e.g., marie.dupont). 
select * from users where email like 'M%';

#9.Identify users whose billing country is missing in the database records. 
select * from users where country is null;

#10.Identify users who have a registered email address on file. 
select * from users where email is not null;

#11.Display user accounts ordered from oldest registration date to newest to identify long-term loyal customers.
select * from users order by RegistrationDate asc;

#12.Identify the top 5 most recently registered users to track daily acquisition. 
select * from users order by RegistrationDate desc limit 5;

#13.Find 'Active' users who are currently registered in the 'United States' or 'India'. 
select * from users where  status = 'active' and country in ('United States' , 'India');

#14.Generate a formatted display label for customer service agents that combines the user's Email and their Country .
select UserID ,concat(Email,"-",country) as userlocationlebel from users; 

#15.Ensure all user emails are standardized in entirely lowercase letters for the data warehouse migration.
select UserID, lower(email) as stadardizedemail from users;

#16.Extract just the first 4 characters of the User's Email to create a short, temporary username.
select UserID, substring(email,1,4) as shortusername from users;

#17.The data team is generating a daily report of all active users. Add a column called ReportGeneratedDate that stamps every row with today's exact date.
select UserID,status,curdate() as ReportGeneratedDate from users where status= "active";

#18.The finance team wants to analyze yearly growth. Extract just the year from the RegistrationDate to see what year each user joined.
select userid,year(registrationDate) as joinyear from users ;

#19.Marketing wants to see if there is a seasonal spike in signups (like around the holidays). Extract the month name from every user's registration date.
select UserID,monthname(registrationdate) as join_month from users;

#20.Customer success wants to calculate the "Account Age" for every user. Find the number of days between the user's RegistrationDate and today.
select UserID,datediff(curdate(),RegistrationDate) as account_age_day from users;

#B. Profile & Demographic Segmentation
#1.Identify profiles that belong to the 'Kids' age group. 
select *from profiles where AgeGroup = 'kids';

#2.Find profiles whose profile names contain the word 'Guest'. 
select *from profiles where ProfileName like '%Guest%';

#3.Display profiles belonging to users from 'India' that are grouped under the 'Adult' age category. 
select * from users as u
join profiles as p on u.UserID=p.UserID
where Country = 'India';

#4.Identify profiles whose age group is neither 'Kids' nor 'Teen'. 
select * from profiles where AgeGroup not in ('kids','teen');

#5.Display profiles whose name starts with the letter 'S' (e.g., Sarah, Sneha). 
select *from profiles where ProfileName like "s%";

#6.Find users whose email addresses belong to the Gmail domain. 
select * from users where email like "%@gmail.com";

#7.Sometimes users accidentally type an extra space before or after their profile name.
select profileid,trim(profilename) standardized_Profilename from profiles;

#C. Content Library Monitoring
#1.Display all content with their type, title, genre, and duration. 
select *from content;

#2.Identify movies (ContentType = 'Movie') that have a duration strictly greater than 120 minutes. 
select *from content where ContentType ='movie' and DurationMins > 120;

#3.Find content with a duration between 30 and 90 minutes. 
select *from content where DurationMins between 30 and 90;

#4.Identify content that belongs to the 'Documentary' or 'Educational' genre. 
select *from content where genre in ('Documentary' , 'Educational');

#5.Display the single movie with the shortest duration in the catalog. 
select *from content order by DurationMins asc limit 1;

#6.Calculate the total number of content titles available on the platform. 
select count(title) as total_titles from content;
select count(*) as total_titles from content;

#7.Calculate the average duration of all movies in the 'Action' genre. 
select avg(durationmins) from content where ContentType = 'movie' and Genre = 'action';

#8.The marketing team wants a list of all movie titles displayed in ALL CAPS for a new promotional flyer.
select contentId,upper(title) as standardize_titles from content;

#9.Find the length (number of characters) of each content title to identify long titles that might get cut off on the mobile app UI.
select contentid,length(title) as title_length from content;

#D. Subscription Plan & Revenue Analysis
#1.Display all subscription plans along with their price and max resolution details. 
select * from plans;

#2.Identify plans that offer '4K' resolution. 
select * from plans where MaxResolution = '4k';

#3.Find the number of users subscribed to each plan type. 
select p.planname,count(u.userid) as total_subscribers from users as u
join plans as p on u.PlanID=p.PlanID
group by p.PlanName
order by count(u.userid) desc;

#4.Calculate the total potential monthly revenue generated by all 'Active' users per plan.  
select u.status,sum(p.monthlyprice) as total_active_revenue
from plans as p 
join users as u on p.PlanID=u.PlanID
where u.Status = 'active';

#5.Identify plans that have more than 10 active subscribers in this dataset. 
select p.Planname,count(u.UserID) as active_subscriber
from plans as p 
join users as u on p.PlanID=u.PlanID
group by p.PlanName
having count(u.UserID)> 10
order by active_subscriber desc;

#6.Find the PlanName with the highest number of registered users. 
select p.planname, count(u.userid)
from plans as p 
join users as u on p.PlanID=u.PlanID
group by p.PlanName
order by count(u.userid)
desc limit 1;

#7.The platform is rebranding the "Standard" plan to be called "Regular". Display the plans, replacing the word "Standard" with "Regular".
select Planid,replace(planName,"Standard","Regular") as standardized_planname from plans;

#E. Viewing Activity & Engagement Analysis
#1.Display all watch history along with profile names and watch dates. 
select w.HistoryID,w.ProfileID,w.ContentID,w.WatchDate,w.MinutesWatched,p.profilename
from watch_history as W
join profiles as p on w.profileid=p.ProfileID
order by w.WatchDate desc;

#2.Identify profiles that have watched a 'TV Show' in the last 30 days. 
select p.profileid,p.profilename,c.contenttype,w.WatchDate
from profiles as p
join watch_history as w on p.ProfileID=w.ProfileID
join content as c on w.ContentID=c.ContentID
where c.ContentType= 'Tv show' and
datediff(curdate(),watchdate)<=30;

#3.Find profiles that have watched both 'Movies' and 'TV Shows'. 
select p.profileid, p.profilename, c.contenttype
from profiles as p
join watch_history as w on p.ProfileID=w.ProfileID
join content as c on w.ContentID=c.ContentID;

#4.Identify specific watch sessions where the MinutesWatched is greater than 150 minutes.
select *from watch_history where MinutesWatched >150;

#5.Calculate the total watch time (in minutes) for each content genre. 
select c.genre,sum(w.minuteswatched) as total_watchtime
from content as c
join watch_history as w on c.ContentID=w.ContentID
group by c.genre 
order by sum(w.MinutesWatched) desc;

#6.Find the average watch time per session for each specific AgeGroup. 
select p.agegroup,avg(w.minuteswatched) as average_watchtime
from profiles as p 
join watch_history as w on p.ProfileID=w.ProfileID
group by p.AgeGroup
order by avg(w.minuteswatched) desc;

#7.Identify the profile with the highest total MinutesWatched across all time. 
select p.profileid,sum(w.minuteswatched) as total_watchtime
from profiles as p
join watch_history as w on p.ProfileID=w.ProfileID
group by p.ProfileID
order by sum(w.minuteswatched)
desc
limit 1 ;

#8.The content team wants to know if people watch more shows on weekends.Extract the name of the day.
select *,dayname(watchdate) as Day_Name from watch_history;

#F. Content Performance Analysis
#1.Display all 'Sci-Fi' movies along with their release years and ratings. 
SELECT Title, ReleaseYear, rating from content 
where ContentType = "Movie" and genre = "sci-fi";

#2.Identify content titles that have been watched for a total of more than 300 minutes platform-wide. 
SELECT c.Title, SUM(w.MinutesWatched) AS TotalMinutes
FROM Watch_History as w
JOIN Content as c ON w.ContentID = c.ContentID
GROUP BY c.Title
HAVING SUM(w.MinutesWatched) > 300
ORDER BY TotalMinutes DESC;

#3.Calculate the total watch time for each specific ContentType (Movie vs. TV Show). 
select c.contenttype, sum(w.minuteswatched) as total_watch
from content as c
join watch_history as w on c.ContentID=w.ContentID
group by c.ContentType;

#4.Identify the specific Content Title with the highest overall watch time. 
select c.title,sum(w.minuteswatched) as highest_watchtime
from content as c
join watch_history as w on c.ContentID=w.ContentID
group by c.Title
order by sum(w.MinutesWatched) desc
limit 1; 

#5.Identifying "Dead" Content:
SELECT c.Title,c.ContentType,SUM(w.MinutesWatched) AS TotalMinutes
FROM Watch_History w
RIGHT JOIN Content c ON w.ContentID = c.ContentID
GROUP BY c.Title, c.ContentType
