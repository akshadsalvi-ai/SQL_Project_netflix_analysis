#J. Customer & Content Risk Classification (CASE Statements).
#1.Classify profiles into 'Children', 'Teenagers', and 'Adults' based on their AgeGroup.
select agegroup,ProfileName,ProfileID,
case
when AgeGroup= 'kids' then 'Childrens'
when AgeGroup='teen' then 'Teenagers'
when AgeGroup='adult' then 'Adults'
else 'Unknown'
end as Audience_Category
from profiles;

#2.Classify content duration into 'Short' (<40 mins), 'Standard' (40-120 mins), and 'Epic' (>120 mins).
select durationmins,ContentType,Title,
case
when durationmins <40 then 'short'
when durationmins between 40 and 120 then 'standard'
when durationmins >120 then 'Epic'
else 'Unknown'
end as content_category
from content;

#3.Classify watch sessions into 'Bounce' (<15 mins), 'Casual' (15-60 mins), and 'Binge' (>60 mins) based on minutes watched.
select minuteswatched,
case
when minuteswatched <15 then 'Bounce'
when minuteswatched between 15 and 60 then 'casual'
when minuteswatched >60 then 'binge'
else 'unknown'
end as watch_sessions
from watch_history;

#4.Classify User accounts based on their status as 'Active', 'Suspended', or 'Cancelled'.
select userId,email,country,status,
case
when status = 'Active' then 'No risk'
when status ='Suspended' then 'At Risk'
when status = 'Cancelled' then 'Churned'
else 'unknown'
end as Risk_level
from users;

